# A senha em POSTGRES_PASSWORD precisa ser a mesma usada em DATABASE_URL.
# Use 127.0.0.1: as portas do compose saem só nesse endereço.
POSTGRES_USER=studio
POSTGRES_PASSWORD=
POSTGRES_DB=studio
DATABASE_URL=postgres://studio@127.0.0.1:5432/studio
REDIS_URL=redis://127.0.0.1:6379
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://studio.aznews.com.br
SEED_ADMIN_EMAIL=
EMAIL_SERVER=
EMAIL_FROM=studio@aznews.com.br
# WordPress local (profile wordpress). Não sobe com pnpm infra:up; use pnpm wp:up.
# Troque as senhas no .env. A senha de aplicativo sai no stdout de pnpm wp:setup.
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=troque-esta-senha
MARIADB_ROOT_PASSWORD=troque-esta-senha-root
WP_BASE_URL=http://127.0.0.1:8080
WP_ADMIN_PASSWORD=troque-esta-senha-admin
WP_USERNAME=studio
WP_APP_PASSWORD=
WP_WEBHOOK_SECRET=troque-este-segredo
LOG_LEVEL=info
