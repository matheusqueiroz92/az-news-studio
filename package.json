{
  "name": "az-news-studio",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @az-news/adapters test:integration",
    "db:migrate": "pnpm --filter @az-news/db migrate",
    "db:seed": "pnpm --filter @az-news/db seed",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.dev.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.dev.yml down",
    "wp:up": "docker compose --env-file .env -f infra/docker-compose.wordpress.yml up -d mariadb wordpress",
    "wp:setup": "docker compose --env-file .env -f infra/docker-compose.wordpress.yml run --rm -T wpcli bash /scripts/bootstrap.sh",
    "wp:down": "docker compose --env-file .env -f infra/docker-compose.wordpress.yml down"
  },
  "devDependencies": {
    "@az-news/config": "workspace:*",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  },
  "prettier": "@az-news/config/prettier.config.mjs"
}
